erDiagram
    %% ===== A. AKUN & KEAMANAN =====
    %% Roles & permissions dikelola oleh spatie/laravel-permission
    USERS ||--o{ MODEL_HAS_ROLES : "assigned"
    ROLES ||--o{ MODEL_HAS_ROLES : "granted to"
    USERS ||--o{ MODEL_HAS_PERMISSIONS : "granted directly"
    PERMISSIONS ||--o{ MODEL_HAS_PERMISSIONS : "granted to"
    ROLES ||--o{ ROLE_HAS_PERMISSIONS : "has"
    PERMISSIONS ||--o{ ROLE_HAS_PERMISSIONS : "belongs to"
    USERS ||--o{ PERSONAL_ACCESS_TOKENS : "owns (sanctum)"

    USERS ||--o| HOST_PROFILES : "has"
    USERS ||--o| TWO_FACTOR_AUTH : "has"
    USERS ||--o{ AUDIT_LOGS : "performs"
    USERS ||--o{ NOTIFICATIONS : "receives"
    USERS ||--o| DISCORD_LINKS : "linked to"

    HOST_PROFILES ||--o| HOST_SENSITIVE_DATA : "has"
    HOST_RATE_CATEGORIES ||--o{ HOST_PROFILES : "classifies"

    %% ===== B. BRAND & JADWAL =====
    HOST_PROFILES ||--o{ HOST_BRAND_ASSIGNMENTS : "assigned to"
    BRANDS ||--o{ HOST_BRAND_ASSIGNMENTS : "has"
    HOST_BRAND_ASSIGNMENTS ||--o{ SCHEDULE_SLOTS : "has"
    HOST_PROFILES ||--o{ HOST_AVAILABILITY : "declares"
    BRANDS ||--o{ SPECIAL_EVENTS : "runs"
    SPECIAL_EVENTS ||--o{ EVENT_SLOT_CLAIMS : "receives"
    HOST_PROFILES ||--o{ EVENT_SLOT_CLAIMS : "claims"
    EVENT_SLOT_CLAIMS ||--o| ATTENDANCES : "checked in"

    %% ===== C. BACKUP =====
    SCHEDULE_SLOTS ||--o{ BACKUP_REQUESTS : "needs"
    HOST_PROFILES ||--o{ BACKUP_REQUESTS : "requests"
    BACKUP_REQUESTS ||--o{ BACKUP_NOMINEES : "suggests"
    HOST_PROFILES ||--o{ BACKUP_NOMINEES : "nominated as"
    BACKUP_REQUESTS ||--o{ BACKUP_APPLICATIONS : "receives"
    HOST_PROFILES ||--o{ BACKUP_APPLICATIONS : "applies"
    HOST_PROFILES ||--o{ BACKUP_QUOTAS : "has monthly"
    BRANDS ||--o{ BACKUP_REQUESTS : "for"
    BACKUP_REQUESTS ||--o{ ATTACHMENTS : "surat sakit"

    %% ===== D. ABSENSI & LAPORAN =====
    HOST_PROFILES ||--o{ ATTENDANCES : "checks in"
    SCHEDULE_SLOTS ||--o{ ATTENDANCES : "for"
    BACKUP_REQUESTS ||--o| ATTENDANCES : "covered by"
    ATTENDANCES ||--o| LIVE_REPORTS : "must fill"
    LIVE_REPORTS ||--o| WORK_SESSIONS : "validated into"
    HOST_PROFILES ||--o{ WORK_SESSIONS : "logs"
    BRANDS ||--o{ WORK_SESSIONS : "for"

    %% ===== E. RATING, POIN, SP =====
    VIOLATION_TYPES ||--o{ POINT_LOGS : "categorizes"
    HOST_PROFILES ||--o{ POINT_LOGS : "has"
    BRAND_COMPLAINTS ||--o| POINT_LOGS : "causes"
    BRANDS ||--o{ BRAND_COMPLAINTS : "issues"
    HOST_PROFILES ||--o{ BRAND_COMPLAINTS : "receives"
    HOST_PROFILES ||--o{ POINT_BALANCES : "has per 3 bulan"
    HOST_PROFILES ||--o{ HOST_RATINGS : "rated"
    HOST_PROFILES ||--o{ WARNING_LETTERS : "receives"
    POINT_LOGS ||--o| WARNING_LETTERS : "may trigger"

    %% ===== F. PAYMENT, KASBON, SLIP =====
    BRANDS ||--o{ PAYMENT_PERIODS : "has"
    PAYMENT_PERIODS ||--o{ WORK_SESSIONS : "counts"
    PAYMENT_PERIODS ||--o{ PAYMENT_ITEMS : "contains"
    HOST_PROFILES ||--o{ PAYMENT_ITEMS : "paid via"
    PAYMENT_PERIODS ||--o{ HOUR_ADJUSTMENTS : "adjusted by"
    PAYMENT_PERIODS ||--o{ PAYMENT_REQUESTS : "generates"
    PAYMENT_PERIODS ||--o{ SALARY_SLIPS : "produces"
    HOST_PROFILES ||--o{ SALARY_SLIPS : "receives"
    HOST_PROFILES ||--o{ CASH_ADVANCES : "requests"
    CASH_ADVANCES ||--o{ CASH_ADVANCE_INSTALLMENTS : "split into"
    PAYMENT_PERIODS ||--o{ CASH_ADVANCE_INSTALLMENTS : "deducted in"
    SALARY_SLIPS ||--o{ CASH_ADVANCE_INSTALLMENTS : "deducts"

    %% ===== G. KONFIGURASI =====
    USERS ||--o{ SYSTEM_SETTINGS : "updates"

    ROLES {
        bigint id PK "spatie"
        string name UK "admin, operator, host"
        string guard_name "web"
        datetime created_at
        datetime updated_at
    }

    PERMISSIONS {
        bigint id PK "spatie"
        string name UK "manage-users, view-finance, ..."
        string guard_name "web"
        datetime created_at
        datetime updated_at
    }

    MODEL_HAS_ROLES {
        bigint role_id PK,FK
        string model_type PK "User model"
        uuid model_id PK "users.id"
    }

    MODEL_HAS_PERMISSIONS {
        bigint permission_id PK,FK
        string model_type PK "User model"
        uuid model_id PK "users.id"
    }

    ROLE_HAS_PERMISSIONS {
        bigint permission_id PK,FK
        bigint role_id PK,FK
    }

    PERSONAL_ACCESS_TOKENS {
        bigint id PK "sanctum"
        string tokenable_type "User model"
        uuid tokenable_id "users.id"
        string name
        string token UK "sha256 hash"
        datetime last_used_at
        datetime expires_at
    }

    USERS {
        uuid id PK
        string name
        string email UK
        datetime email_verified_at "diisi otomatis saat login Google"
        string password "nullable, hash only; null untuk akun Google-only"
        string google_id UK "nullable, sub dari Google"
        string avatar "nullable, URL Google atau path upload; foto profil semua role (pengganti photo_path)"
        enum status "pending, active, inactive (sementara, jadwal tetap), archived (resign, jadwal dihentikan); status host_profiles ikut ini"
        enum signup_source "admin_created, self_register"
        uuid approved_by FK
        datetime approved_at
        boolean two_factor_enabled
        datetime last_login_at
        datetime erased_at "hapus permanen: data pribadi dianonimkan, riwayat kerja & gaji tetap"
        string remember_token
        datetime created_at
        datetime updated_at
        datetime deleted_at "soft delete"
    }

    TWO_FACTOR_AUTH {
        uuid id PK
        uuid user_id FK "unique; admins only"
        string secret_key_encrypted "TOTP secret, encrypted"
        json recovery_codes_hash "bcrypt hash per one-time code"
        boolean is_enabled
        datetime enabled_at
        bigint last_used_step "blocks reusing a code"
    }

    HOST_RATE_CATEGORIES {
        uuid id PK
        string name UK "magang, baru, di atas 1 tahun"
        int min_tenure_months UK "auto naik dari join_date"
        decimal rate_per_hour
        datetime created_at
        datetime updated_at
    }

    HOST_PROFILES {
        uuid id PK
        uuid user_id FK,UK "dibuat otomatis saat admin approve host"
        uuid rate_category_id FK
        boolean rate_category_overridden "true = diset manual admin, job harian tidak mengubah"
        string phone
        string guardian_phone "no telp wali/keluarga"
        date join_date "default tanggal approve, hanya admin yang ubah"
        enum status "active, inactive, archived, banned"
        datetime created_at
        datetime updated_at
    }

    HOST_SENSITIVE_DATA {
        uuid id PK
        uuid host_id FK,UK
        text ktp_number "encrypted (Laravel encrypted cast)"
        string ktp_image_path "disk private, hanya admin"
        string bank_name
        text bank_account "encrypted (Laravel encrypted cast)"
        string account_holder_name
        datetime created_at
        datetime updated_at
    }

    BRANDS {
        uuid id PK
        string name UK
        boolean is_obs
        text product_knowledge "info produk untuk host yang di-assign"
        int target_hours_per_period "konfigurable per brand"
        int payment_cycle_days
        date payroll_start_date "awal periode pembayaran pertama; periode berikutnya berurutan per siklus"
        enum status "active, inactive"
        datetime created_at
        datetime updated_at
    }

    HOST_BRAND_ASSIGNMENTS {
        uuid id PK
        uuid host_id FK "unik per (host_id, brand_id)"
        uuid brand_id FK
        boolean is_leader "maksimal 1 leader aktif per brand"
        enum status "active, inactive, banned"
        datetime created_at
        datetime updated_at
    }

    SCHEDULE_SLOTS {
        uuid id PK
        uuid assignment_id FK "host + brand"
        tinyint day_of_week "1=Senin ... 7=Minggu, berulang tiap minggu"
        enum slot_type "regular, pd"
        time start_time
        time end_time
        boolean crosses_midnight "otomatis jika end <= start, contoh 23:00 - 01:00"
        boolean is_locked "hanya admin yang bisa ubah/hapus/unlock"
        enum status "active, inactive"
        date effective_from
        date effective_to "null = berlaku terus; hapus slot lama = isi tanggal ini"
        datetime created_at
        datetime updated_at
    }

    HOST_AVAILABILITY {
        uuid id PK
        uuid host_id FK
        tinyint day_of_week "1=Senin ... 7=Minggu"
        time available_from
        time available_to "boleh lewat tengah malam"
        string note
        datetime created_at
        datetime updated_at
    }

    SPECIAL_EVENTS {
        uuid id PK
        uuid brand_id FK
        string name "PD, double date"
        date start_date
        date end_date
        time daily_start_time "jam buka tiap hari"
        time daily_end_time "boleh lewat tengah malam"
        smallint block_minutes "panjang blok yang bisa diklaim, mis. 120"
        boolean open_full_schedule "jadwal dibuka kosong: slot reguler brand tidak berlaku di hari event"
        int max_slots_per_host
        enum status "active, cancelled"
        uuid created_by FK
        datetime created_at
        datetime updated_at
    }

    EVENT_SLOT_CLAIMS {
        uuid id PK
        uuid event_id FK
        uuid host_id FK
        datetime start_at "satu blok"
        datetime end_at
        enum status "active, overridden, cancelled"
        uuid claimed_by FK "host sendiri, atau admin/operator yang menugaskan"
        datetime claimed_at
        datetime created_at
        datetime updated_at
    }

    BACKUP_REQUESTS {
        uuid id PK
        uuid slot_id FK
        uuid brand_id FK "snapshot brand slot saat request"
        uuid requesting_host_id FK
        uuid created_by FK "admin/operator bisa buat atas nama host (langsung open)"
        date backup_date
        datetime start_at
        datetime end_at
        enum reason_type "sick, permit, other"
        string reason
        enum request_type "open (semua host boleh apply), direct (hanya nominee)"
        enum status "open (belum ada pelamar), pending (pelamar menunggu keputusan admin), filled, cancelled, rejected (data lama)"
        uuid approved_by FK "admin yang ACC host pengganti; null jika auto-ACC"
        datetime approved_at
        datetime auto_fill_at "start_at - 30 menit: sistem ACC pelamar terbaik"
        boolean auto_filled
        boolean counts_toward_quota "true jika host pengganti beda brand"
        boolean letter_penalty_applied "poin sudah dipotong karena surat sakit telat"
        uuid filled_by_host_id FK
        datetime filled_at
        datetime cancelled_at
        datetime created_at
        datetime updated_at
    }

    BACKUP_NOMINEES {
        uuid id PK "host yang dipilih langsung (min 2, maks backup.direct_max_hosts)"
        uuid backup_request_id FK "unik per (request, host)"
        uuid nominee_host_id FK "jawaban nominee = apply di BACKUP_APPLICATIONS"
        datetime created_at
        datetime updated_at
    }

    BACKUP_APPLICATIONS {
        uuid id PK
        uuid backup_request_id FK "unik per (request, host)"
        uuid applicant_host_id FK
        enum status "applied, approved, rejected, withdrawn, cancelled"
        boolean penalty_applied "cancelled = batal setelah di-ACC; poin dipotong oleh modul poin"
        datetime decided_at
        datetime created_at "applied_at"
        datetime updated_at
    }

    BACKUP_QUOTAS {
        uuid id PK
        uuid host_id FK "host yang MEMBANTU brand lain"
        string month_year "YYYY-MM, unik per host"
        int quota_used
        int quota_max "default 3, bisa diubah per host/bulan"
        datetime created_at
        datetime updated_at
    }

    ATTENDANCES {
        uuid id PK
        uuid host_id FK
        uuid slot_id FK "null untuk blok event"
        uuid backup_request_id FK "diisi jika host sedang backup"
        uuid event_claim_id FK,UK "diisi untuk blok event"
        uuid brand_id FK
        date session_date "tanggal sesi (slot occurrence)"
        datetime scheduled_start_at "snapshot jadwal"
        datetime scheduled_end_at
        datetime check_in_at "belum ada aturan telat (TBD)"
        datetime check_out_at
        datetime report_due_at "check_in_at plus 24 jam"
        datetime created_at
        datetime updated_at
    }

    LIVE_REPORTS {
        uuid id PK
        uuid attendance_id FK,UK
        uuid host_id FK
        uuid brand_id FK
        int session_count
        decimal duration_hours
        json metrics "sementara: gmv, orders, viewers (template dari agency menyusul)"
        string notes
        enum status "submitted, flagged, approved, rejected"
        json flag_reasons "late_report, no_check_out, more_than_scheduled, ..."
        datetime submitted_at
        uuid reviewed_by FK "null = auto-approve"
        datetime reviewed_at
        string review_note
        datetime created_at
        datetime updated_at
    }

    WORK_SESSIONS {
        uuid id PK
        uuid live_report_id FK,UK
        uuid host_id FK
        uuid brand_id FK
        uuid payment_period_id FK "diisi saat modul payroll"
        date session_date
        datetime start_at
        datetime end_at
        decimal duration_hours "jam yang dibayar"
        enum session_type "regular, backup, event, double, disrupted, adjustment"
        enum status "normal, flagged, carried_over"
        string notes
        datetime created_at
        datetime updated_at
    }

    VIOLATION_TYPES {
        uuid id PK
        string name UK "telat, main HP, ketiduran, batal backup, surat sakit telat, komplain brand"
        string code UK "untuk potongan otomatis: backup_cancel, late_sick_letter, brand_complaint"
        int default_points "poin yang dipotong"
        decimal rating_impact "lebih kecil dari poin, mis. 0.5 dari rating 1-5"
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    BRAND_COMPLAINTS {
        uuid id PK
        uuid host_id FK
        uuid brand_id FK
        string description
        uuid recorded_by FK
        datetime created_at
        datetime updated_at
    }

    POINT_LOGS {
        uuid id PK
        uuid host_id FK
        uuid violation_type_id FK
        uuid brand_complaint_id FK
        enum source "internal, brand_complaint, backup_cancel, late_attachment"
        int points_change "negatif = potongan"
        string reason
        uuid recorded_by FK "null = otomatis oleh sistem"
        date period_start "awal periode poin (per 3 bulan)"
        date occurred_on
        datetime voided_at "dibatalkan admin (salah input)"
        uuid voided_by FK
        datetime created_at
        datetime updated_at
    }

    POINT_BALANCES {
        uuid id PK "pengganti MONTHLY_POINT_BALANCES: reset tiap 3 bulan"
        uuid host_id FK "unik per (host, period_start)"
        date period_start "Jan, Apr, Jul, Okt"
        date period_end
        int opening_points "100"
        int current_points "opening + potongan, minimal 0"
        datetime created_at
        datetime updated_at
    }

    HOST_RATINGS {
        uuid id PK
        uuid host_id FK "unik per (host, month_year)"
        string month_year "YYYY-MM"
        decimal rating "1.0 - 5.0"
        decimal suggested_rating "5 - total rating_impact pelanggaran bulan itu"
        string note
        uuid rated_by FK "penilaian admin, bukan sesama host"
        datetime created_at
        datetime updated_at
    }

    WARNING_LETTERS {
        uuid id PK
        uuid host_id FK
        uuid point_log_id FK "null jika diterbitkan manual"
        tinyint level "1 = SP1, 2 = SP2, 3 = SP3; otomatis di 75 / 50 / 25 poin"
        date period_start "periode poin saat terbit"
        string reason
        uuid issued_by FK "null = otomatis"
        datetime issued_at
        datetime voided_at
        uuid voided_by FK
        datetime created_at
        datetime updated_at
    }

    PAYMENT_PERIODS {
        uuid id PK
        uuid brand_id FK "unik per (brand, period_start)"
        date period_start
        date period_end
        int target_hours "snapshot target brand"
        decimal worked_hours "semua jam kerja + penyesuaian di periode ini"
        decimal achieved_hours "ditagih ke brand: min(worked + carried_in, target)"
        decimal carried_in_hours "sisa dari periode sebelumnya"
        decimal carried_out_hours "kelebihan ke periode berikutnya"
        enum status "in_progress, waiting_payment, requested, paid"
        datetime locked_at "terkunci setelah request payment"
        datetime created_at
        datetime updated_at
    }

    PAYMENT_ITEMS {
        uuid id PK
        uuid payment_period_id FK "unik per (periode, host)"
        uuid host_id FK
        int session_count
        decimal hours "host dibayar semua jam kerja (carry-over hanya untuk tagihan brand, belum final)"
        decimal rate_per_hour "snapshot saat periode ditutup"
        decimal amount
        datetime created_at
        datetime updated_at
    }

    HOUR_ADJUSTMENTS {
        uuid id PK
        uuid payment_period_id FK
        uuid host_id FK
        int sessions_added "boleh negatif"
        decimal hours_added "boleh negatif"
        string notes
        uuid created_by FK
        datetime created_at
        datetime updated_at
    }

    PAYMENT_REQUESTS {
        uuid id PK
        uuid payment_period_id FK
        uuid requested_by FK
        datetime requested_at
        enum status "requested, processing, paid"
        string exported_report_url "laporan CSV untuk brand"
        datetime paid_at
        datetime created_at
        datetime updated_at
    }

    CASH_ADVANCES {
        uuid id PK
        uuid host_id FK
        uuid brand_id FK "opsional: brand saat kasbon dicatat"
        enum type "early_payment, loan"
        decimal total_amount
        int installment_count
        string notes
        enum status "unpaid, in_progress, paid"
        uuid recorded_by FK
        datetime requested_at
        datetime created_at
        datetime updated_at
    }

    CASH_ADVANCE_INSTALLMENTS {
        uuid id PK
        uuid cash_advance_id FK
        uuid payment_period_id FK "diisi saat dipotong"
        int seq
        decimal amount
        uuid salary_slip_id FK "slip tempat cicilan dipotong"
        uuid deducted_brand_id FK "diisi saat potongan diproses (slip brand mana pun)"
        enum status "scheduled, deducted, skipped"
        datetime deducted_at
        datetime created_at
        datetime updated_at
    }

    SALARY_SLIPS {
        uuid id PK
        uuid host_id FK "unik per (host, periode)"
        uuid payment_period_id FK
        decimal gross_amount
        decimal advance_deduction "cicilan kasbon yang dipotong"
        decimal net_amount
        string pdf_path "null: slip ditampilkan sebagai halaman cetak"
        datetime generated_at "saat periode ditandai lunas"
        datetime sent_at
        datetime created_at
        datetime updated_at
    }

    ATTACHMENTS {
        uuid id PK
        string owner_type "backup_request, cash_advance, live_report, host_profile, payment_request"
        uuid owner_id
        string file_path
        string mime_type
        int size_kb
        uuid uploaded_by FK
        datetime uploaded_at
    }

    NOTIFICATIONS {
        uuid id PK "satu baris per pengiriman"
        uuid user_id FK "null untuk pesan ke channel Discord"
        string type "backup_opened, backup_picked, report_flagged, sp_issued, slip_ready, ..."
        string title
        string body
        string link "halaman frontend, mis. /host/backups"
        json payload
        enum channel "web, discord_channel, discord_dm"
        string target "id channel Discord untuk discord_channel"
        enum status "pending, sent, failed, skipped"
        tinyint attempts
        string error
        datetime sent_at
        datetime read_at "untuk notifikasi web"
        datetime created_at
        datetime updated_at
    }

    DISCORD_LINKS {
        uuid id PK
        uuid user_id FK,UK
        string discord_user_id UK
        string discord_username
        string dm_channel_id "disimpan setelah DM pertama"
        datetime linked_at
        datetime created_at
        datetime updated_at
    }

    SYSTEM_SETTINGS {
        uuid id PK
        string key UK "path in config/vidhelp.php, e.g. backup.quota_per_month, points.sp_thresholds.1"
        json value "admin override; no row = config default"
        uuid updated_by FK
        datetime created_at
        datetime updated_at
    }

    AUDIT_LOGS {
        uuid id PK
        uuid user_id FK "actor; null = system or failed login"
        string action "login, login_failed, logout, create, update, delete, approve, role_change, two_factor_*"
        string target_table
        uuid target_id
        string target_label
        json old_value "hidden/encrypted fields stored as [hidden]"
        json new_value
        string ip_address
        string user_agent
        datetime created_at
    }
